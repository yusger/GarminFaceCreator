import Toybox.Application;import Toybox.WatchUi;import Toybox.Lang;
 function gfcThemeId(){var theme="apex";try{var value=Application.Properties.getValue("Gfc_Theme");if(value instanceof Lang.Number){if(value==2009808953){theme="apex";}if(value==2078923795){theme="trail";}if(value==1156566441){theme="vital";}}}catch(e){}return theme;}
 class GfcSettingsMenu extends WatchUi.Menu2{
 function initialize(mode,control){Menu2.initialize({:title=>"trail Settings"});menuMode=mode;menuControl=control;rebuild();}
 var menuMode=null;var menuControl=null;
 function onShow(){Menu2.onShow();rebuild();WatchUi.requestUpdate();}
 function addValues(key,labels,values){for(var i=0;i<labels.size();i++){addItem(new WatchUi.MenuItem(labels[i],null,{:action=>"set",:key=>key,:value=>values[i]},{}));}}
 function clearItems(){while(deleteItem(0)==true){}}
 function navigate(mode,control){clearItems();WatchUi.pushView(new GfcSettingsMenu(mode,control),new GfcSettingsDelegate(),WatchUi.SLIDE_IMMEDIATE);}
