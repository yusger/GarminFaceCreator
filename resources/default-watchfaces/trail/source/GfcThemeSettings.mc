 class GfcSettingsDelegate extends WatchUi.Menu2InputDelegate{
 function initialize(){Menu2InputDelegate.initialize();}
 function onBack(){var menu=WatchUi.getCurrentView()[0] as GfcSettingsMenu;menu.clearItems();Menu2InputDelegate.onBack();WatchUi.requestUpdate();}
 function onSelect(item){var id=item.getId() as Lang.Dictionary;var action=id[:action];var menu=WatchUi.getCurrentView()[0] as GfcSettingsMenu;
 if(action.equals("themes")){menu.navigate("themes",null);}
 else if(action.equals("background")){menu.navigate("background",null);}
 else if(action.equals("group")){menu.navigate(id[:mode],null);}
 else if(action.equals("control")){menu.navigate("values",id[:id]);}
 else if(action.equals("set")){Application.Properties.setValue(id[:key],id[:value]);Application.getApp().onSettingsChanged();menu.clearItems();WatchUi.popView(WatchUi.SLIDE_IMMEDIATE);WatchUi.requestUpdate();}
 else if(action.equals("reset")){var theme=gfcThemeId();if(theme.equals("apex")){Application.Properties.setValue("Gfc_Background_2009808953",0x0E1319);Application.Properties.setValue("Gfc_Source_apex_value_apex_tl",1007610278);Application.Properties.setValue("Gfc_apex_value_apex_tl_color",0x38E1D0);Application.Properties.setValue("Gfc_Source_apex_value_apex_tr",588927973);Application.Properties.setValue("Gfc_apex_value_apex_tr_color",0xEAF1F6);Application.Properties.setValue("Gfc_Source_apex_value_apex_bl",1492996704);Application.Properties.setValue("Gfc_apex_value_apex_bl_color",0xFF6A1A);Application.Properties.setValue("Gfc_Source_apex_value_apex_br",473628861);Application.Properties.setValue("Gfc_apex_value_apex_br_color",0xFFC04A);Application.Properties.setValue("Gfc_apex_battery_color",0x38E1D0);Application.Properties.setValue("Gfc_apex_time_color",0xEAF1F6);Application.Properties.setValue("Gfc_apex_show_bg_art",true);Application.Properties.setValue("Gfc_apex_show_ticks",true);Application.Properties.setValue("Gfc_apex_show_seconds",true);}if(theme.equals("trail")){Application.Properties.setValue("Gfc_Background_2078923795",0x100E0B);Application.Properties.setValue("Gfc_Source_trail_value_trail_tl",2019471002);Application.Properties.setValue("Gfc_trail_value_trail_tl_color",0x38E1D0);Application.Properties.setValue("Gfc_Source_trail_value_trail_tr",473628861);Application.Properties.setValue("Gfc_trail_value_trail_tr_color",0xFFC04A);Application.Properties.setValue("Gfc_Source_trail_value_trail_bl",1007610278);Application.Properties.setValue("Gfc_trail_value_trail_bl_color",0xEAF1F6);Application.Properties.setValue("Gfc_Source_trail_value_trail_br",588927973);Application.Properties.setValue("Gfc_trail_value_trail_br_color",0x8492A0);Application.Properties.setValue("Gfc_trail_battery_color",0xEAF1F6);Application.Properties.setValue("Gfc_trail_time_color",0xFFC04A);Application.Properties.setValue("Gfc_trail_show_bg_art",true);Application.Properties.setValue("Gfc_tr