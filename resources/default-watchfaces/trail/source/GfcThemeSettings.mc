 }
 class GfcSettingsDelegate extends WatchUi.Menu2InputDelegate{
 function initialize(){Menu2InputDelegate.initialize();}
 function onSelect(item){var id=item.getId() as Lang.Dictionary;var action=id[:action];
 if(action.equals("themes")){WatchUi.pushView(new GfcSettingsMenu("themes",null),new GfcSettingsDelegate(),WatchUi.SLIDE_IMMEDIATE);}
 else if(action.equals("control")){WatchUi.pushView(new GfcSettingsMenu("values",id[:id]),new GfcSettingsDelegate(),WatchUi.SLIDE_IMMEDIATE);}
 else if(action.equals("set")){Application.Properties.setValue(id[:key],id[:value]);Application.getApp().onSettingsChanged();WatchUi.popView(WatchUi.SLIDE_IMMEDIATE);}
 else if(action.equals("reset")){var theme=gfcThemeId();if(theme.equals("apex")){Application.Properties.setValue("Gfc_apex_value_apex_tl",0);Application.Properties.setValue("Gfc_apex_value_apex_tl_color",0x38E1D0);Application.Properties.setValue("Gfc_apex_value_apex_tr",1);Application.Properties.setValue("Gfc_apex_value_apex_tr_color",0xEAF1F6);Application.Properties.setValue("Gfc_apex_value_apex_bl",2);Application.Properties.setValue("Gfc_apex_value_apex_bl_color",0xFF6A1A);Application.Properties.setValue("Gfc_apex_value_apex_br",3);Application.Properties.setValue("Gfc_apex_value_apex_br_color",0xFFC04A);Application.Properties.setValue("Gfc_apex_battery_color",0x38E1D0);Application.Properties.setValue("Gfc_apex_time_color",0xEAF1F6);Application.Properties.setValue("Gfc_apex_show_bg_art",true);Application.Properties.setValue("Gfc_apex_show_ticks",true);Application.Properties.setValue("Gfc_apex_show_seconds",true);}if(theme.equals("trail")){Application.Properties.setValue("Gfc_trail_value_trail_tl",5);Application.Properties.setValue("Gfc_trail_value_trail_tl_color",0x38E1D0);Application.Properties.setValue("Gfc_trail_value_trail_tr",3);Application.Properties.setValue("Gfc_trail_value_trail_tr_color",0xFFC04A);Application.Properties.setValue("Gfc_trail_value_trail_bl",0);Application.Properties.setValue("Gfc_trail_value_trail_bl_color",0xEAF1F6);Application.Properties.setValue("Gfc_trail_value_trail_br",1);Application.Properties.setValue("Gfc_trail_value_trail_br_color",0x8492A0);Application.Properties.setValue("Gfc_trail_battery_color",0xEAF1F6);Application.Properties.setValue("Gfc_trail_time_color",0xFFC04A);Application.Properties.setValue("Gfc_trail_show_bg_art",true);Application.Properties.setValue("Gfc_trail_show_ticks",true);Application.Properties.setValue("Gfc_trail_show_seconds",true);}if(theme.equals("vital")){Application.Properties.setValue("Gfc_vital_heart_big",0);Application.Properties.setValue("Gfc_vital_heart_big_color",0x38E1D0);Application.Properties.setValue("Gfc_vital_value_vital_bl",1);Application.Properties.setValue("Gfc_vital_value_vital_bl_color",0x38E1D0);Application.Properties.setValue("Gfc_vital_value_vital_br",2);Application.Properties.setValue("Gfc_vital_value_vital_br_color",0xFFC04A);Application.Properties.setValue("Gfc_vital_battery_color",0x38E1D0);Application.Properties.setValue("Gfc_vital_time_color",0xEAF1F6);Application.Properties.setValue("Gfc_vital_show_bg_art",true);Application.Properties.setValue("Gfc_vital_show_ticks",true);Application.Properties.setValue("Gfc_vital_show_zone_decoration",true);}Application.getApp().onSettingsChanged();WatchUi.requestUpdate();}
 }
 }
