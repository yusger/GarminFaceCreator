dc.setFill(Graphics.createColor(255,(0xafffa6>>16)&255,(0xafffa6>>8)&255,0xafffa6&255));dc.setStroke(Graphics.createColor(255,(0xafffa6>>16)&255,(0xafffa6>>8)&255,0xafffa6&255));dc.setColor(0xafffa6,Graphics.COLOR_TRANSPARENT);dc.drawText(px(322.5),px(252.5),Graphics.FONT_SMALL,zonep0.hour.format("%02d")+":"+zonep0.min.format("%02d"),Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);
{var value=dataheartRate;var ink=0x738077;if(metricValid(value,false)){if(value>=0 && value<120){ink=0x55ff99;}else if(value>=120 && value<150){ink=0xffee44;}else if(value>=150 && true){ink=0xff5566;}}dc.setFill(Graphics.createColor(255,(ink>>16)&255,(ink>>8)&255,ink&255));dc.setStroke(Graphics.createColor(255,(ink>>16)&255,(ink>>8)&255,ink&255));dc.setColor(ink,Graphics.COLOR_TRANSPARENT);dc.drawText(px(322.5),px(304),Graphics.FONT_XTINY,metricText(value,"heartRate","HR ","",-1,"--"),Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}
