{dc.setFill(Graphics.createColor(255,(0x3c6d47>>16)&255,(0x3c6d47>>8)&255,0x3c6d47&255));dc.setStroke(Graphics.createColor(255,(0x3c6d47>>16)&255,(0x3c6d47>>8)&255,0x3c6d47&255));dc.setPenWidth(px(1));dc.drawLine(px(227),px(98),px(228),px(360));}
{var value=databattery;var ink=0x738077;if(metricValid(value,true)){if(value>=0 && value<10){ink=0xff5566;}else if(value>=10 && value<30){ink=0xffee44;}else if(value>=30 && true){ink=0xd7e3da;}}dc.setFill(Graphics.createColor(255,(ink>>16)&255,(ink>>8)&255,ink&255));dc.setStroke(Graphics.createColor(255,(ink>>16)&255,(ink>>8)&255,ink&255));dc.setColor(ink,Graphics.COLOR_TRANSPARENT);dc.drawText(px(322.5),px(116),Graphics.FONT_XTINY,metricText(value,"battery","BAT ","%",-1,"--"),Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}
{var value=datasteps;dc.setFill(Graphics.createColor(255,(0xd7e3da>>16)&255,(0xd7e3da>>8)&255,0xd7e3da&255));dc.setStroke(Graphics.createColor(255,(0xd7e3da>>16)&255,(0xd7e3da>>8)&255,0xd7e3da&255));dc.setColor(0xd7e3da,Graphics.COLOR_TRANSPARENT);dc.drawText(px(322.5),px(169),Graphics.FONT_XTINY,metricText(value,"steps","ST ","",-1,"--"),Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}
