{
  "format": "gfc-control-cases",
  "formatVersion": 1,
  "cases": [
    {
      "id": "normal",
      "data": {
        "temperature": 24
      },
      "parameters": {},
      "expect": {
        "nativeSources": [
          "temperature"
        ]
      }
    },
    {
      "id": "zero",
      "data": {
        "temperature": 0
      },
      "parameters": {},
      "expect": {
        "heartRateZero": "missing",
        "otherZero": "valid"
      }
    },
    {
      "id": "missing",
      "data": {
        "temperature": null
      },
      "parameters": {},
      "expect": {
        "metrics": "--",
        "ringsLit": 0
      }
    },
    {
      "id": "aod",
      "data": {},
      "parameters": {},
      "expect": {
        "mode": "aod",
        "ringsLit": 0
      }
    },
    {
      "id": "max",
      "data": {
        "temperature": 1000
      },
      "parameters": {},
      "expect": {
        "saturateProgress": true
      }
    }
  ]
}
