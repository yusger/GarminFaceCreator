{
  "format": "gfc-control-cases",
  "formatVersion": 1,
  "cases": [
    {
      "id": "normal",
      "data": {
        "heartRate": 148,
        "steps": 10689,
        "calories": 426,
        "battery": 78
      },
      "parameters": {},
      "expect": {
        "heartRate": "148",
        "steps": "10689",
        "calories": "426",
        "battery": "78%"
      }
    },
    {
      "id": "zero",
      "data": {
        "heartRate": 0,
        "steps": 0,
        "calories": 0,
        "battery": 0
      },
      "parameters": {},
      "expect": {
        "heartRate": "--",
        "steps": "0",
        "calories": "0",
        "battery": "0%"
      }
    },
    {
      "id": "missing",
      "data": {
        "heartRate": null,
        "steps": null,
        "calories": null,
        "battery": null
      },
      "parameters": {},
      "expect": {
        "heartRate": "--",
        "steps": "--",
        "calories": "--",
        "battery": "--"
      }
    },
    {
      "id": "max",
      "data": {
        "heartRate": 255,
        "steps": 50000,
        "calories": 9999,
        "battery": 100
      },
      "parameters": {},
      "expect": {
        "heartRate": "255",
        "steps": "50000",
        "calories": "9999",
        "battery": "100%"
      }
    },
    {
      "id": "boundary",
      "data": {
        "heartRate": 120,
        "steps": 10000,
        "calories": 500,
        "battery": 30
      },
      "parameters": {},
      "expect": {
        "heartRate": "120",
        "steps": "10000",
        "calories": "500",
        "battery": "30%"
      }
    },
    {
      "id": "aod",
      "aod": true,
      "data": {
        "heartRate": 148,
        "steps": 10689,
        "calories": 426,
        "battery": 78
      },
      "parameters": {},
      "expect": {
        "visibleLayers": [
          "heartrate-icon",
          "heartrate-glyph",
          "heartrate-value"
        ]
      }
    },
    {
      "id": "configured",
      "data": {
        "heartRate": 148,
        "steps": 10689,
        "calories": 426,
        "battery": 78
      },
      "parameters": {
        "accent": "#FFAA00",
        "show-label": false
      },
      "expect": {
        "heartRate": "148",
        "steps": "10689",
        "calories": "426",
        "battery": "78%",
        "parameters": {
          "accent": "#FFAA00",
          "show-label": false
        },
        "color@accent": "#FFAA00",
        "visible@show-label": false
      }
    }
  ]
}
