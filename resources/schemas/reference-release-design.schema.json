{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gfc:reference-release-design:1",
  "title": "GFC reference release schema26 project envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 26
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "updated": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "const": 0
    },
    "codeRevision": {
      "const": -1
    },
    "versions": {
      "type": "array",
      "maxItems": 0
    },
    "files": {
      "type": "array",
      "maxItems": 0
    },
    "assets": {
      "type": "array",
      "maxItems": 0
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "deviceSize": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "backgroundColor": {
      "type": "string",
      "pattern": "^#[A-Fa-f0-9]{6}$"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "x",
          "y",
          "w",
          "h",
          "color",
          "size",
          "rotation",
          "hidden",
          "locked",
          "text",
          "source",
          "aod",
          "aodColor",
          "threshold"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "widget",
              "time",
              "date",
              "metric",
              "text",
              "image",
              "wordTime",
              "hand",
              "celestial",
              "calendar",
              "meter",
              "ring",
              "rect",
              "circle",
              "line"
            ]
          },
          "x": {
            "type": "number",
            "minimum": -454,
            "maximum": 908
          },
          "y": {
            "type": "number",
            "minimum": -454,
            "maximum": 908
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 908
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 908
          },
          "color": {
            "type": "string",
            "pattern": "^#[A-Fa-f0-9]{6}$"
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 200
          },
          "rotation": {
            "const": 0,
            "description": "deterministic-v1 does not accept layer transforms; time-driven hand angles are separate."
          },
          "hidden": {
            "const": false
          },
          "locked": {
            "type": "boolean"
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "source": {
            "type": "string",
            "maxLength": 80
          },
          "aod": {
            "type": "boolean"
          },
          "aodColor": {
            "type": "string",
            "pattern": "^#[A-Fa-f0-9]{6}$"
          },
          "threshold": {
            "type": "boolean"
          },
          "image": false,
          "assetId": false,
          "effectPrompt": {
            "const": ""
          },
          "metricDecoration": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "description": "Structural envelope only. All extra Layer fields require the pinned schema26 semantic validator, closed field allowlist, and capability profile. Passing JSON Schema alone is insufficient.",
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "metric"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "source": {
                  "enum": [
                    "steps",
                    "battery",
                    "seconds",
                    "distance",
                    "calories",
                    "heartRate",
                    "temperature"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "meter"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "source": {
                  "enum": [
                    "steps",
                    "battery"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "metric"
                },
                "source": {
                  "const": "heartRate"
                }
              },
              "required": [
                "kind",
                "source"
              ]
            },
            "then": {
              "properties": {
                "metricDecoration": {
                  "const": false
                }
              },
              "required": [
                "metricDecoration"
              ]
            }
          }
        ]
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object"
      }
    },
    "controlValues": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": [
          "string",
          "boolean"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "appId",
    "name",
    "updated",
    "revision",
    "codeRevision",
    "versions",
    "files",
    "target",
    "deviceSize",
    "backgroundColor",
    "layers"
  ]
}
