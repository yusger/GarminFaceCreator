{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gfc:theme-project:1",
  "title": "Closed schema49 theme-project-v1 submission",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 49
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "updated": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "const": 0
    },
    "codeRevision": {
      "const": -1
    },
    "versions": {
      "type": "array",
      "maxItems": 0
    },
    "files": {
      "type": "array",
      "maxItems": 0
    },
    "assets": {
      "type": "array",
      "maxItems": 0
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "deviceSize": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "backgroundColor": {
      "type": "string",
      "pattern": "^#[A-Fa-f0-9]{6}$"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "type",
          "default",
          "targets"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "enum": [
              "color",
              "boolean",
              "dataSource"
            ]
          },
          "default": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "options": {
            "type": "array",
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layerId",
                "property"
              ],
              "properties": {
                "layerId": {
                  "type": "string"
                },
                "property": {
                  "type": "string",
                  "pattern": "^(color|activeVisible|source|thresholdRules\\.[0-7]\\.color)$"
                }
              }
            }
          },
          "hideWhenChangedFromDefault": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "semantic": {
            "enum": [
              "primary",
              "accent",
              "track",
              "text",
              "warning",
              "danger"
            ]
          },
          "slot": {
            "const": true
          },
          "sourceLabels": {
            "type": "object",
            "maxProperties": 40,
            "additionalProperties": {
              "type": "string"
            }
          },
          "sourceUnits": {
            "type": "object",
            "maxProperties": 40,
            "additionalProperties": {
              "type": "string"
            }
          },
          "sourcePrecisions": {
            "type": "object",
            "maxProperties": 40,
            "additionalProperties": {
              "type": "number"
            }
          },
          "sourceGoals": {
            "type": "object",
            "maxProperties": 40,
            "additionalProperties": {
              "type": "number"
            }
          },
          "sourceIcons": {
            "type": "object",
            "maxProperties": 40,
            "additionalProperties": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 200,
              "items": {
                "type": "string"
              }
            }
          },
          "preserveFormatFor": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "controlValues": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": [
          "string",
          "boolean"
        ]
      }
    },
    "fontRoles": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "themeId": {
            "type": "string"
          },
          "fontId": {
            "type": "string"
          },
          "layerIds": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "fontId",
          "layerIds"
        ]
      }
    },
    "themes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "activeId": {
          "type": "string"
        },
        "defaultId": {
          "type": "string"
        },
        "presets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "layerIds": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 200,
                "items": {
                  "type": "string"
                }
              },
              "controlIds": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 200,
                "items": {
                  "type": "string"
                }
              },
              "backgroundColor": {
                "type": "string",
                "pattern": "^#[A-Fa-f0-9]{6}$"
              }
            },
            "required": [
              "id",
              "name",
              "version",
              "layerIds",
              "controlIds",
              "backgroundColor"
            ]
          }
        }
      },
      "required": [
        "version",
        "activeId",
        "defaultId",
        "presets"
      ]
    },
    "multiDevice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "master": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "scope": {
          "const": "master"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "target": {
                "enum": [
                  "venu445mm",
                  "venu441mm"
                ]
              },
              "deviceSize": {
                "enum": [
                  "45mm",
                  "41mm"
                ]
              },
              "overrides": {
                "type": "object",
                "maxProperties": 200,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": -454,
                      "maximum": 908
                    },
                    "y": {
                      "type": "number",
                      "minimum": -454,
                      "maximum": 908
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 908
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 908
                    },
                    "size": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 200
                    },
                    "rotation": {
                      "type": "number",
                      "minimum": -360,
                      "maximum": 360
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#[A-Fa-f0-9]{6}$"
                    },
                    "strokeColor": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "strokeWidth": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "ringWidth": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "arcSpacing": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 12
                    },
                    "aod": {
                      "type": "boolean"
                    },
                    "aodColor": {
                      "type": "string",
                      "pattern": "^#[A-Fa-f0-9]{6}$"
                    },
                    "aodSize": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "exportIncluded": {
                      "const": true
                    },
                    "hidden": {
                      "const": false
                    },
                    "customFont": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "family",
                            "file"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            },
                            "family": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            },
                            "file": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "garminFont": {
                      "anyOf": [
                        {
                          "enum": [
                            "auto",
                            "xtiny",
                            "tiny",
                            "small",
                            "medium",
                            "large",
                            "numberHot",
                            "systemXTiny"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fontWeight": {
                      "anyOf": [
                        {
                          "enum": [
                            400,
                            600,
                            700
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bitmapFontId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bitmapTracking": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": -8,
                          "maximum": 32
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bitmapTabular": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bitmapBaselineShift": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": -64,
                          "maximum": 64
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "bitmapLineHeight": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 256
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": []
                }
              },
              "revision": {
                "const": 0
              },
              "code": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "files": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "versions": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "codeRevision": {
                    "const": -1
                  }
                },
                "required": [
                  "files",
                  "versions",
                  "codeRevision"
                ]
              }
            },
            "required": [
              "key",
              "target",
              "deviceSize",
              "overrides",
              "revision",
              "code"
            ]
          }
        }
      },
      "required": [
        "master",
        "scope",
        "variants"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "appId",
    "name",
    "updated",
    "revision",
    "codeRevision",
    "versions",
    "files",
    "target",
    "deviceSize",
    "backgroundColor",
    "layers"
  ],
