          "type": "number"
        },
        "allowClip": {
          "type": "boolean"
        },
        "dateFormat": {
          "enum": [
            "monthDayWeek"
          ]
        },
        "wordLanguage": {
          "enum": [
            "en",
            "zh"
          ]
        },
        "wordRow": {
          "enum": [
            "all",
            "top",
            "middle",
            "bottom"
          ]
        },
        "solarPart": {
          "enum": [
            "sky",
            "body"
          ]
        },
        "calendarStart": {
          "enum": [
            "monday",
            "sunday"
          ]
        },
        "solarNightColor": {
          "type": "string",
          "maxLength": 100
        },
        "solarMissingColor": {
          "type": "string",
          "maxLength": 100
        },
        "calendarTodayColor": {
          "type": "string",
          "maxLength": 100
        },
        "calendarTodayText": {
          "type": "string",
          "maxLength": 100
        },
        "calendarMutedColor": {
          "type": "string",
          "maxLength": 100
        },
        "calendarHeaderColor": {
          "type": "string",
          "maxLength": 100
        },
        "iconMask": {
          "type": "boolean"
        },
        "preserveSourceLabelDefault": {
          "type": "boolean"
        },
        "sourceLabelStyle": {
          "enum": [
            "unit",
            "label",
            "unitLabel"
          ]
        },
        "bitmapFontId": {
          "type": "string"
        },
        "bitmapTracking": {
          "type": "number",
          "minimum": -8,
          "maximum": 32
        },
        "bitmapTabular": {
          "type": "boolean"
        },
        "bitmapBaselineShift": {
          "type": "number",
          "minimum": -64,
          "maximum": 64
        },
        "bitmapLineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "polygon"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "polygonPoints"
            ],
            "properties": {
              "polygonPoints": {
                "type": "array",
                "minItems": 3,
                "maxItems": 32,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "polygonPoints": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ring"
              }
            },
            "required": [
              "kind"
            ]
          },
          "else": {
            "properties": {
              "ringStyle": false,
              "ringCap": false
            }
          }
        }
      ]
    },
    "compound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "width",
        "height",
        "layers",
        "controls",
        "parts"
      ],
      "properties": {
        "version": {
          "enum": [
            1,
            2
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 454
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 454
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "controls": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "type",
              "default",
              "targets"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "color",
                  "boolean",
                  "dataSource"
                ]
              },
              "default": {
                "type": [
                  "string",
                  "boolean"
                ]
              },
              "options": {
                "type": "array",
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "layerId",
                    "property"
                  ],
                  "properties": {
                    "layerId": {
                      "type": "string"
                    },
                    "property": {
                      "type": "string",
                      "pattern": "^(color|activeVisible|source|thresholdRules\\.[0-7]\\.color)$"
                    }
                  }
                }
              },
              "hideWhenChangedFromDefault": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "controlValues": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          }
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "layerIds",
              "enabled"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "active": {
                "type": "boolean"
              },
              "aod": {
                "type": "boolean"
              },
              "layerIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "disabledLayers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Independent profile; not a widening of deterministic-v2. Semantic validation, inventory and per-target SDK gates also required."
}
