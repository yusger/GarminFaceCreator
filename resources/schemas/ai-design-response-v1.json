{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gfc:ai-design-response:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backgroundColor",
    "layers"
  ],
  "properties": {
    "backgroundColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "x",
          "y",
          "w",
          "h",
          "size",
          "color",
          "aod"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "time",
              "date",
              "hand",
              "ring",
              "metric",
              "text",
              "rect",
              "circle",
              "line",
              "meter",
              "image",
              "polygon",
              "arcText"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number",
            "minimum": 1,
            "maximum": 908
          },
          "h": {
            "type": "number",
            "minimum": 1,
            "maximum": 908
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 200
          },
          "rotation": {
            "type": "number"
          },
          "arcRadius": {
            "type": "number"
          },
          "arcStartAngle": {
            "type": "number"
          },
          "arcDirection": {
            "type": "string"
          },
          "arcSpacing": {
            "type": "number"
          },
          "polygonPoints": {
            "type": "array",
            "minItems": 3,
            "maxItems": 32,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "text": {
            "type": "string"
          },
          "source": {
            "enum": [
              "heartRate",
              "steps",
              "battery",
              "calories",
              "distance",
              "temperature",
              "stress",
              "recoveryHours",
              "floorsClimbed",
              "intensityMinutes",
              "humidity",
              "uvIndex",
              "altitude",
              "windSpeed"
            ]
          },
          "activeVisible": {
            "type": "boolean"
          },
          "aod": {
            "type": "boolean"
          },
          "aodColor": {
            "type": "string"
          },
          "aodSize": {
            "type": "number"
          },
          "aodSeconds": {
            "type": "string"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "textAlign": {
            "enum": [
              "left",
              "center",
              "right"
            ]
          },
          "fontWeight": {
            "type": "number"
          },
          "garminFont": {
            "enum": [
              "auto",
              "xtiny",
              "systemXTiny",
              "tiny",
              "small",
              "medium",
              "large",
              "numberHot"
            ]
          },
          "timePart": {
            "enum": [
              "full",
              "hours",
              "minutes",
              "seconds"
            ]
          },
          "dateLocale": {
            "enum": [
              "en",
              "zh"
            ]
          },
          "dateFormat": {
            "enum": [
              "monthDayWeek",
              "weekdayDay"
            ]
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "precision": {
            "type": "number"
          },
          "groupThousands": {
            "type": "boolean"
          },
          "autoSourceFormat": {
            "type": "boolean"
          },
          "metricDecoration": {
            "type": "boolean"
          },
          "missingValue": {
            "type": "string"
          },
          "threshold": {
            "type": "boolean"
          },
          "thresholdRules": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color"
              ],
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            }
          },
          "thresholdFallback": {
            "type": "string"
          },
          "meterContinuous": {
            "type": "boolean"
          },
          "meterDimColor": {
            "type": "string"
          },
          "meterShape": {
            "type": "string"
          },
          "meterCount": {
            "type": "number"
          },
          "meterGoal": {
            "type": "number"
          },
          "meterDim": {
            "type": "number"
          },
          "ringStyle": {
            "enum": [
              "ticks",
              "continuous"
            ]
          },
          "ringCap": {
            "enum": [
              "round",
              "butt"
            ]
          },
          "ringTicks": {
            "type": "number"
          },
          "ringStart": {
            "type": "number"
          },
          "ringEnd": {
            "type": "number"
          },
          "ringWidth": {
            "type": "number"
          },
          "ringSource": {
            "enum": [
              "static",
              "seconds",
              "heartRate",
              "steps",
              "battery"
            ]
          },
          "ringGoal": {
            "type": "number"
          },
          "ringDim": {
            "type": "number"
          },
          "handType": {
            "enum": [
              "hour",
              "minute",
              "second"
            ]
          },
          "handPivotX": {
            "type": "number"
          },
          "handPivotY": {
            "type": "number"
          },
          "handReach": {
            "type": "number"
          },
          "handTail": {
            "type": "number"
          },
          "handCap": {
            "enum": [
              "round",
              "butt"
            ]
          },
          "handShape": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "points"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,79}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "maxItems": 32,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "strokeWidth": {
            "type": "number"
          },
          "fillEnabled": {
            "type": "boolean"
          },
          "strokeEnabled": {
            "type": "boolean"
          },
          "strokeColor": {
            "type": "string"
          },
          "cornerRadius": {
            "type": "number"
          },
          "allowClip": {
            "type": "boolean"
          },
          "groupId": {
            "type": "string"
          },
          "groupName": {
            "type": "string"
          },
          "effectPrompt": {
            "type": "string"
          },
          "referenceId": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "date"
                },
                "dateLocale": {
                  "const": "zh"
                }
              },
              "required": [
                "kind",
                "dateLocale"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "dateFormat"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
