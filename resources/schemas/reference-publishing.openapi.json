    "/api/internal/reference-library/{slug}/activate": {
      "post": {
        "operationId": "activateReferenceVersion",
        "summary": "Atomically activate an own historical published version",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
