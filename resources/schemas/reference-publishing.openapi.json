{
  "openapi": "3.1.0",
  "info": {
    "title": "GFC intranet reference publishing API",
    "version": "1.0.0-draft",
    "description": "DESIGN CONTRACT ONLY. Not deployed. Management operations are intranet-only and require publisher-scoped credentials. No native source/script uploads in v1; no AI calls. Package contracts are reference-release*.schema.json."
  },
  "servers": [
    {
      "url": "https://gfc-publish.internal",
      "description": "Placeholder, not a working deployment"
    }
  ],
  "security": [
    {
      "PublisherToken": []
    }
  ],
  "paths": {
    "/api/internal/reference-publishing/capabilities": {
      "get": {
        "operationId": "getReferencePublishingCapabilities",
        "summary": "Query authenticated publisher identity, limits, ready targets and profiles",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "x-required-scopes": [
          "reference:read"
        ]
      }
    },
    "/api/internal/reference-publications": {
      "post": {
        "operationId": "submitReferencePublication",
        "summary": "Upload a ready-to-generate design package; asynchronous validation and publication",
        "responses": {
          "200": {
            "description": "Idempotent replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "202": {
            "description": "Accepted; detailed validation is asynchronous",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "package": {
                    "type": "string",
                    "format": "binary"
                  },
                  "packageSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "intent": {
                    "enum": [
                      "validate",
                      "publish"
                    ]
                  },
                  "expectedCurrentVersion": {
                    "type": "string",
                    "pattern": "^(none|(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))$"
                  }
                },
                "required": [
                  "package",
                  "packageSha256",
                  "intent",
                  "expectedCurrentVersion"
                ]
              },
              "encoding": {
                "package": {
                  "contentType": "application/zip"
                }
              }
            }
          }
        },
        "x-required-scopes": [
          "reference:submit"
        ],
        "description": "intent=publish also requires reference:publish; namespace ownership always enforced."
      }
    },
    "/api/internal/reference-publications/{jobId}": {
      "get": {
        "operationId": "getReferencePublication",
        "summary": "Read own publication task",
        "responses": {
          "200": {
            "description": "Success",
