  "components": {
    "securitySchemes": {
      "PublisherToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque revocable publisher-scoped token, unrelated to model API keys"
      }
    },
    "responses": {
      "Problem": {
        "description": "Error; see stable code and diagnostics",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          }
        },
        "required": [
          "status",
          "code",
          "title",
          "detail",
          "traceId"
        ]
      },
      "Diagnostic": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "layerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "caseId": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "stage",
          "message"
        ]
      },
      "Checks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "structure": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          },
          "resources": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          },
          "capabilities": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          },
          "cases": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          },
          "sdk": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          },
          "visual": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          },
          "simulator": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          },
          "device": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "not_applicable"
            ]
          }
        },
        "required": [
          "structure",
          "resources",
          "capabilities",
          "cases",
          "sdk",
          "visual",
          "simulator",
          "device"
        ]
      },
      "Publication": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "validating",
              "generating",
              "compiling",
              "ready",
              "publishing",
              "published",
              "failed",
              "cancelled"
            ]
          },
          "intent": {
            "enum": [
              "validate",
              "publish"
            ]
          },
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "packageSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/Checks"
          },
          "summary": {
            "type": "string"
          },
          "statusUrl": {
            "type": "string"
          },
          "reportUrl": {
            "type": "string"
          },
          "releaseUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "jobId",
          "status",
          "intent",
          "key",
          "version",
          "packageSha256",
          "stage",
          "createdAt",
          "updatedAt",
          "expiresAt",
          "checks",
          "summary",
          "statusUrl",
          "reportUrl",
          "releaseUrl"
        ]
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "validating",
              "generating",
              "compiling",
              "ready",
              "publishing",
              "published",
              "failed",
              "cancelled"
            ]
          },
          "intent": {
            "enum": [
              "validate",
              "publish"
            ]
          },
          "packageSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "statusUrl": {
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "status",
          "intent",
          "packageSha256",
          "statusUrl"
        ]
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string"
          },
          "checks": {
            "$ref": "#/components/schemas/Checks"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "checks",
          "diagnostics",
          "summary"
        ]
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "const": "1"
          },
          "publisherId": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packageFormatVersions": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "projectSchemaVersions": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "generatorVersion": {
                  "type": "string"
                },
                "capabilityIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "generatorVersion",
                "capabilityIds"
              ]
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string"
                },
                "deviceSize": {
                  "type": "string"
                },
                "screenWidth": {
                  "type": "integer"
                },
