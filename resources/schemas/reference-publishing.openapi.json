          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-required-scopes": [
          "reference:read"
        ]
      }
    },
    "/api/internal/reference-publications/{jobId}/publish": {
      "post": {
        "operationId": "publishValidatedReference",
        "summary": "Promote a ready candidate using its original expectedCurrentVersion",
        "responses": {
