{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GFC hand image pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "version",
    "name",
    "authors",
    "license",
    "licenseFile",
    "canvas",
    "aod",
    "sets"
  ],
  "properties": {
    "format": {
      "const": "gfc-hand-image-pack"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "licenseFile": {
      "const": "LICENSE"
    },
    "note": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "pivot",
        "orient"
      ],
      "properties": {
        "width": {
          "const": 400
        },
        "height": {
          "const": 400
        },
        "orient": {
          "const": "up"
        },
        "pivot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "const": 200
            },
            "y": {
              "const": 200
            }
          }
        }
      }
    },
    "aod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hour",
        "minute",
        "second",
        "cap",
        "tintColor"
      ],
      "properties": {
        "hour": {
          "const": true
        },
        "minute": {
          "const": true
        },
        "second": {
          "const": false
        },
        "cap": {
          "const": false
        },
        "tintColor": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        }
      }
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "resources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hour",
              "minute",
              "second",
              "cap"
            ],
            "properties": {
              "hour": {
                "type": "string",
                "pattern": "^hands/[a-z0-9-]+\\.png$"
              },
              "minute": {
                "type": "string",
                "pattern": "^hands/[a-z0-9-]+\\.png$"
              },
              "second": {
                "type": "string",
                "pattern": "^hands/[a-z0-9-]+\\.png$"
              },
              "cap": {
                "type": "string",
                "pattern": "^hands/[a-z0-9-]+\\.png$"
              }
            }
          }
        }
      }
    }
  }
}
