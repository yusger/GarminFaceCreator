{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Editable layout definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backgroundColor",
    "layers"
  ],
  "properties": {
    "backgroundColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "x",
          "y",
          "w",
          "h",
          "color",
          "size",
          "aod"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "text",
              "time",
              "date",
              "metric",
              "rect",
              "circle",
              "line",
              "image",
              "meter",
              "ring",
              "hand"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 200
          },
          "aod": {
            "type": "boolean"
          },
          "aodColor": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "text": {
            "type": "string",
            "maxLength": 200
          },
          "source": {
            "enum": [
              "heartRate",
              "steps",
              "calories",
              "battery",
              "altitude",
              "pressure",
              "temperature",
              "distance",
              "seconds"
            ]
          },
          "garminFont": {
            "enum": [
              "auto",
              "xtiny",
              "tiny",
              "small",
              "medium",
              "large",
              "numberHot",
              "systemXTiny"
            ]
          },
          "resourceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "rotation": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          },
          "strokeWidth": {
            "type": "number",
            "minimum": 1,
            "maximum": 32
          },
          "strokeColor": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "fillEnabled": {
            "type": "boolean"
          },
          "strokeEnabled": {
            "type": "boolean"
          },
          "cornerRadius": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "textAlign": {
            "enum": [
              "left",
              "center",
              "right"
            ]
          },
          "precision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "unit": {
            "type": "string",
            "maxLength": 12
          },
          "missingValue": {
            "const": "--"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "groupThousands": {
            "type": "boolean"
          },
          "thresholdFallback": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "thresholdRules": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color"
              ],
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              }
            }
          },
          "meterContinuous": {
            "type": "boolean"
          },
          "meterDimColor": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "meterShape": {
            "const": "bar"
          },
          "meterCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "meterGoal": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ringSource": {
            "enum": [
              "static",
              "battery",
              "steps",
              "heartRate",
              "seconds"
            ]
          },
          "ringTicks": {
            "type": "integer",
            "minimum": 4,
            "maximum": 180
          },
          "ringGoal": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ringDim": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ringWidth": {
            "type": "number",
            "minimum": 1,
            "maximum": 32
          },
          "ringStart": {
            "type": "number"
          },
          "ringEnd": {
            "type": "number"
          },
          "timePart": {
            "enum": [
              "full",
              "hours",
              "minutes",
              "seconds"
            ]
          },
          "dateLocale": {
            "enum": [
              "en",
              "zh"
            ]
          },
          "handType": {
            "enum": [
              "hour",
              "minute",
              "second"
            ]
          },
          "handPivotX": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "handPivotY": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "handReach": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1
          },
          "handTail": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.3
          },
          "handCap": {
            "enum": [
              "butt",
              "round"
            ]
          },
          "aodSeconds": {
            "enum": [
              "hide",
              "zero"
            ]
          },
          "activeVisible": {
            "type": "boolean"
          },
          "threshold": {
            "type": "boolean"
          },
          "allowClip": {
            "type": "boolean"
          },
          "metricDecoration": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
