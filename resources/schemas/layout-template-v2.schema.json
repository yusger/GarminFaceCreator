{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Layout template descriptor v2 (visual kits)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "version",
    "name",
    "mode",
    "canvas",
    "layoutFile",
    "preview",
    "previewAod",
    "defaultSources",
    "description",
    "origin",
    "background",
    "visualKit"
  ],
  "properties": {
    "format": {
      "const": "gfc-layout-template"
    },
    "formatVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "DIGITAL",
        "ANALOG",
        "HYBRID"
      ]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "shape",
        "safeInset"
      ],
      "properties": {
        "width": {
          "const": 454
        },
        "height": {
          "const": 454
        },
        "shape": {
          "const": "circle"
        },
        "safeInset": {
          "type": "number",
          "minimum": 0,
          "maximum": 40
        }
      }
    },
    "layoutFile": {
      "const": "layout.json"
    },
    "preview": {
      "const": "preview.svg"
    },
    "previewAod": {
      "const": "preview-aod.svg"
    },
    "defaultSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "heartRate",
          "steps",
          "calories",
          "battery",
          "altitude",
          "pressure",
          "temperature",
          "distance",
          "seconds"
        ]
      }
    },
    "description": {
      "type": "string"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authors",
        "license",
        "licenseFile"
      ],
      "properties": {
        "kind": {
          "enum": [
            "self",
            "community"
          ]
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseFile": {
          "const": "LICENSE"
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solid",
        "uploadImage"
      ],
      "properties": {
        "solid": {
          "const": true
        },
        "uploadImage": {
          "const": true
        }
      }
    },
    "visualKit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "fonts",
        "colorRoles",
        "aodGuide"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "venu445mm",
              "venu441mm"
            ]
          }
        },
        "fonts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "colorRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "color",
              "layerIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "layerIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "aodGuide": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
