{
  "format": "gfc-layout-template",
  "formatVersion": 2,
  "id": "kit-minimal",
  "version": "1.0.0",
  "name": "极简细线",
  "mode": "DIGITAL",
  "canvas": {
    "width": 454,
    "height": 454,
    "shape": "circle",
    "safeInset": 20
  },
  "layoutFile": "layout.json",
  "preview": "preview.svg",
  "previewAod": "preview-aod.svg",
  "defaultSources": [
    "battery"
  ],
  "description": "真实轻线字体、克制刻度与薄荷色装饰；息屏只保留小号时间。",
  "origin": {
    "kind": "self",
    "authors": [
      "yusger"
    ],
    "license": "GPL-3.0-or-later",
    "licenseFile": "LICENSE"
  },
  "background": {
    "solid": true,
    "uploadImage": true
  },
  "visualKit": {
    "targets": [
      "venu445mm",
      "venu441mm"
    ],
    "fonts": [
      "sonar_label_font",
      "rajdhani_light"
    ],
    "colorRoles": [
      {
        "id": "ink-0",
        "label": "配色 1",
        "color": "#263B43",
        "layerIds": [
          "hour-ticks"
        ]
      },
      {
        "id": "ink-1",
        "label": "配色 2",
        "color": "#7E919C",
        "layerIds": [
          "brand",
          "date"
        ]
      },
      {
        "id": "ink-2",
        "label": "配色 3",
        "color": "#D6F6ED",
        "layerIds": [
          "clock"
        ]
      },
      {
        "id": "ink-3",
        "label": "配色 4",
        "color": "#56D5B2",
        "layerIds": [
          "accent",
          "battery-icon",
          "battery"
        ]
      }
    ],
    "aodGuide": "独立小号时间层，仅AOD显示；不保留圆弧、装饰与实时数据。像素占比和原生Sleep需独立验证。"
  }
}
