      "maxLayers": 8,
      "maxChars": 80,
      "minimumApi": "5.1.0",
      "characterSet": "printable ASCII",
      "font": "scalable Graphics.FONT_SMALL only",
      "radius": "fraction of min(w,h), 0.05..0.5",
      "spacing": "logical pixels, 0..12",
      "size": "6..80 logical pixels per mode",
      "widthBudget": "n*size+(n-1)*spacing <= circumference (conservative program policy, not device limit)"
    },
    "dataSlots": {
