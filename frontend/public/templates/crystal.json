      "content": "// GarminFaceCreator local generator basic-5-data; approximate system font mapping, no SDK fonts bundled.\n// Crystal Creator adaptation of warmsound/crystal-face @ bcc340484bd2a3a09f13b22a2d0d6dae3b4de9c7; layout adaptation GPL-3.0-only. See distributed Crystal notices.\nimport Toybox.Application;import Toybox.WatchUi;import Toybox.Graphics;import Toybox.System;import Toybox.ActivityMonitor;import Toybox.Time;import Toybox.Time.Gregorian;\nclass GeneratedApp extends Application.AppBase {function initialize(){AppBase.initialize();} function getInitialView(){return [new GeneratedView()];}}\nclass GeneratedView extends WatchUi.WatchFace {\n var sleeping=false;var scale=1.0;\n function initialize(){WatchFace.initialize();}\n function onEnterSleep(){sleeping=true;WatchUi.requestUpdate();}\n function onExitSleep(){sleeping=false;WatchUi.requestUpdate();}\n function meterCount(value,goal,count,battery){if(value==null || value!=value || value<0 || value>1.0e12 || (battery && value>100)){return 0;}if(value>=goal){return count;}return (value*1.0/goal*count).toNumber();}\n function metricValid(value,battery){return value!=null && value==value && value>=0 && value<1.0e12 && (!battery || value<=100);}\n function metricText(value,source,label,unit,precision,missing){\n  if(!metricValid(value,source.equals(\"battery\"))){return label+missing;}\n  var text=\"\";\n  if(precision>=0){text=value.toFloat().format(\"%.\"+precision.format(\"%d\")+\"f\");}\n  else if(source.equals(\"seconds\")){text=value.toNumber().format(\"%02d\");}\n  else if(source.equals(\"steps\")){var digits=value.toNumber().format(\"%d\");var length=digits.length();for(var i=0;i<length;i++){if(i>0 && (length-i)%3==0){text+=\",\";}text+=digits.substring(i,i+1);}}\n  else {text=value.toFloat().format(\"%.6f\");while(text.length()>0 && text.substring(text.length()-1,text.length()).equals(\"0\")){text=text.substring(0,text.length()-1);}if(text.substring(text.length()-1,text.length()).equals(\".\")){text=text.substring(0,text.length()-1);}}\n  return label+text+unit;\n }\n function px(value){return (value*scale).toNumber();}\n function onUpdate(dc as Graphics.Dc) as Void {\n  scale=dc.getWidth()/454.0;var clock=System.getClockTime();var datasteps=null;var databattery=null;var datadistance=null;var datacalories=null;try {var info=ActivityMonitor.getInfo();if(info!=null){if(info has :steps){datasteps=info.steps;}if(info has :distance){datadistance=info.distance==null ? null : info.distance/100000.0;}if(info has :calories){datacalories=info.calories;}}}catch(e){}try {databattery=System.getSystemStats().battery;}catch(e){}var calendar=Gregorian.info(Time.now(),Time.FORMAT_SHORT);var dateText=[\"SUN\",\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\",\"SAT\"][calendar.day_of_week-1]+\" \"+calendar.day.format(\"%d\");\n  dc.setColor(Graphics.COLOR_BLACK,Graphics.COLOR_BLACK);dc.clear();dc.setBlendMode(Graphics.BLEND_MODE_SOURCE_OVER);\n  if(sleeping){{dc.setFill(Graphics.createColor(255,(0x000000>>16)&255,(0x000000>>8)&255,0x000000&255));dc.setStroke(Graphics.createColor(255,(0x000000>>16)&255,(0x000000>>8)&255,0x000000&255));dc.setPenWidth(px(2));var polygon=[[px(454),px(227)],[px(452.058),px(256.6294)],[px(446.2652),px(285.7519)],[px(436.7207),px(313.8691)],[px(423.5878),px(340.5)],[px(407.0912),px(365.1888)],[px(387.5132),px(387.5132)],[px(365.1888),px(407.0912)],[px(340.5),px(423.5878)],[px(313.8691),px(436.7207)],[px(285.7519),px(446.2652)],[px(256.6294),px(452.058)],[px(227),px(454)],[px(197.3706),px(452.058)],[px(168.2481),px(446.2652)],[px(140.1309),px(436.7207)],[px(113.5),px(423.5878)],[px(88.8112),px(407.0912)],[px(66.4868),px(387.5132)],[px(46.9088),px(365.1888)],[px(30.4122),px(340.5)],[px(17.2793),px(313.8691)],[px(7.7348),px(285.7519)],[px(1.942),px(256.6294)],[px(0),px(227)],[px(1.942),px(197.3706)],[px(7.7348),px(168.2481)],[px(17.2793),px(140.1309)],[px(30.4122),px(113.5)],[px(46.9088),px(88.8112)],[px(66.4868),px(66.4868)],[px(88.8112),px(46.9088)],[px(113.5