# Development server: GFC_ variables are server-side config, not browser model settings.
GFC_API_PROXY=http://127.0.0.1:18380
GFC_DEV_HOST=127.0.0.1
GFC_DEV_PORT=5173

# Optional Docker port publishing; use 0.0.0.0 deliberately for trusted LAN access.
# Existing deployments without an .env keep 0.0.0.0:18380.
GFC_BIND_ADDRESS=127.0.0.1
GFC_HTTP_PORT=18380
