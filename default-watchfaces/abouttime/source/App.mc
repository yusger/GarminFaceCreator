{var rows=GfcWordTime.lines(clock.hour,clock.min,0,"en");dc.setFill(Graphics.createColor(255,(0x535e69>>16)&255,(0x535e69>>8)&255,0x535e69&255));dc.setStroke(Graphics.createColor(255,(0x535e69>>16)&255,(0x535e69>>8)&255,0x535e69&255));dc.setColor(0x535e69,Graphics.COLOR_TRANSPARENT);for(var line=0;line<1;line++){dc.drawText(px(227),px(143+(line+0.5)*48/1),Graphics.FONT_SMALL,rows[0],Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}}
{var rows=GfcWordTime.lines(clock.hour,clock.min,0,"en");dc.setFill(Graphics.createColor(255,(0x5e6a75>>16)&255,(0x5e6a75>>8)&255,0x5e6a75&255));dc.setStroke(Graphics.createColor(255,(0x5e6a75>>16)&255,(0x5e6a75>>8)&255,0x5e6a75&255));dc.setColor(0x5e6a75,Graphics.COLOR_TRANSPARENT);for(var line=0;line<1;line++){dc.drawText(px(227),px(204+(line+0.5)*54/1),Graphics.FONT_MEDIUM,rows[1],Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}}
{var rows=GfcWordTime.lines(clock.hour,clock.min,0,"en");dc.setFill(Graphics.createColor(255,(0x667e79>>16)&255,(0x667e79>>8)&255,0x667e79&255));dc.setStroke(Graphics.createColor(255,(0x667e79>>16)&255,(0x667e79>>8)&255,0x667e79&255));dc.setColor(0x667e79,Graphics.COLOR_TRANSPARENT);for(var line=0;line<1;line++){dc.drawText(px(227),px(273+(line+0.5)*70/1),Graphics.FONT_LARGE,rows[2],Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}}

}else{{dc.setFill(Graphics.createColor(255,(0x08121a>>16)&255,(0x08121a>>8)&255,0x08121a&255));dc.setStroke(Graphics.createColor(255,(0x08121a>>16)&255,(0x08121a>>8)&255,0x08121a&255));dc.setPenWidth(px(2));var polygon=[[px(454),px(227)],[px(452.058),px(256.6294)],[px(446.2652),px(285.7519)],[px(436.7207),px(313.8691)],[px(423.5878),px(340.5)],[px(407.0912),px(365.1888)],[px(387.5132),px(387.5132)],[px(365.1888),px(407.0912)],[px(340.5),px(423.5878)],[px(313.8691),px(436.7207)],[px(285.7519),px(446.2652)],[px(256.6294),px(452.058)],[px(227),px(454)],[px(197.3706),px(452.058)],[px(168.2481),px(446.2652)],[px(140.1309),px(436.7207)],[px(113.5),px(423.5878)],[px(88.8112),px(407.0912)],[px(66.4868),px(387.5132)],[px(46.9088),px(365.1888)],[px(30.4122),px(340.5)],[px(17.2793),px(313.8691)],[px(7.7348),px(285.7519)],[px(1.942),px(256.6294)],[px(0),px(227)],[px(1.942),px(197.3706)],[px(7.7348),px(168.2481)],[px(17.2793),px(140.1309)],[px(30.4122),px(113.5)],[px(46.9088),px(88.8112)],[px(66.4868),px(66.4868)],[px(88.8112),px(46.9088)],[px(113.5),px(30.4122)],[px(140.1309),px(17.2793)],[px(168.2481),px(7.7348)],[px(197.3706),px(1.942)],[px(227),px(0)],[px(256.6294),px(1.942)],[px(285.7519),px(7.7348)],[px(313.8691),px(17.2793)],[px(340.5),px(30.4122)],[px(365.1888),px(46.9088)],[px(387.5132),px(66.4868)],[px(407.0912),px(88.8112)],[px(423.5878),px(113.5)],[px(436.7207),px(140.1309)],[px(446.2652),px(168.2481)],[px(452.058),px(197.3706)]];dc.fillPolygon(polygon);}
dc.setFill(Graphics.createColor(255,(0x70828e>>16)&255,(0x70828e>>8)&255,0x70828e&255));dc.setStroke(Graphics.createColor(255,(0x70828e>>16)&255,(0x70828e>>8)&255,0x70828e&255));dc.setColor(0x70828e,Graphics.COLOR_TRANSPARENT);dc.drawText(px(227),px(57),Graphics.FONT_XTINY,"ABOUT TIME",Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);
dc.setFill(Graphics.createColor(255,(0x9aadba>>16)&255,(0x9aadba>>8)&255,0x9aadba&255));dc.setStroke(Graphics.createColor(255,(0x9aadba>>16)&255,(0x9aadba>>8)&255,0x9aadba&255));dc.setColor(0x9aadba,Graphics.COLOR_TRANSPARENT);dc.drawText(px(227),px(105),Graphics.FONT_XTINY,dateText,Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);
{var rows=GfcWordTime.lines(clock.hour,clock.min,clock.sec,"en");dc.setFill(Graphics.createColor(255,(0x93aabd>>16)&255,(0x93aabd>>8)&255,0x93aabd&255));dc.setStroke(Graphics.createColor(255,(0x93aabd>>16)&255,(0x93aabd>>8)&255,0x93aabd&255));dc.setColor(0x93aabd,Graphics.COLOR_TRANSPARENT);for(var line=0;line<1;line++){dc.drawText(px(227),px(143+(line+0.5)*48/1),Graphics.FONT_SMALL,rows[0],Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}}
{var rows=GfcWordTime.lines(clock.hour,clock.min,clock.sec,"en");dc.setFill(Graphics.createColor(255,(0xc4d4e0>>16)&255,(0xc4d4e0>>8)&255,0xc4d4e0&255));dc.setStroke(Graphics.createColor(255,(0xc4d4e0>>16)&255,(0xc4d4e0>>8)&255,0xc4d4e0&255));dc.setColor(0xc4d4e0,Graphics.COLOR_TRANSPARENT);for(var line=0;line<1;line++){dc.drawText(px(227),px(204+(line+0.5)*54/1),Graphics.FONT_MEDIUM,rows[1],Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}}
{var rows=GfcWordTime.lines(clock.hour,clock.min,clock.sec,"en");dc.setFill(Graphics.createColor(255,(0x76dcba>>16)&255,(0x76dcba>>8)&255,0x76dcba&255));dc.setStroke(Graphics.createColor(255,(0x76dcba>>16)&255,(0x76dcba>>8)&255,0x76dcba&255));dc.setColor(0x76dcba,Graphics.COLOR_TRANSPARENT);for(var line=0;line<1;line++){dc.drawText(px(227),px(273+(line+0.5)*70/1),Graphics.FONT_LARGE,rows[2],Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}}
{dc.setFill(Graphics.createColor(255,(0x243643>>16)&255,(0x243643>>8)&255,0x243643&255));dc.setStroke(Graphics.createColor(255,(0x243643>>16)&255,(0x243643>>8)&255,0x243643&255));dc.setPenWidth(px(1));dc.drawLine(px(158),px(371),px(296),px(372));}
{var value=databattery;var ink=0x8ea2b0;if(metricValid(value,true)){if(value>=0 && value<10){ink=0xff5566;}else if(value>=10 && value<30){ink=0xffee44;}else if(value>=30 && true){ink=0x8ea2b0;}}dc.setFill(Graphics.createColor(255,(ink>>16)&255,(ink>>8)&255,ink&255));dc.setStroke(Graphics.createColor(255,(ink>>16)&255,(ink>>8)&255,ink&255));dc.setColor(ink,Graphics.COLOR_TRANSPARENT);dc.drawText(px(227),px(405),Graphics.FONT_XTINY,metricText(value,"battery","BAT ","%",-1,"--"),Graphics.TEXT_JUSTIFY_CENTER|Graphics.TEXT_JUSTIFY_VCENTER);}}
